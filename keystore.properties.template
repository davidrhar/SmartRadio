# Copy to keystore.properties and fill in. That file is gitignored and must never be committed.
#
# Generate the upload keystore ONCE (see docs/release.md), keep it outside the repository, and back
# it up with its password. Lose it and Play needs a key reset (support request), so treat it as
# irreplaceable.
#
# storeFile=../skipadoodle-upload.jks
storeFile=
keyAlias=skipadoodle

# PASSWORD: prefer the macOS keychain over this file, which is plaintext at rest:
#   security add-generic-password -a "$USER" -s skipadoodle-release -w
# The build reads that first and only falls back to the fields below (CI, other machines).
keychainService=
storePassword=
keyPassword=
